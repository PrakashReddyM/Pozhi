# ==========================================
# PRODUCTION ENVIRONMENT — copy this to .env.production and fill in real values
# NEVER commit .env.production to git
# ==========================================

NODE_ENV=production
PORT=5000

# ---- Database -------------------------------------------------------
# Container name in docker-compose.prod.yml is "postgres", port 5432 internally
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@postgres:5432/pozhi

# ---- Redis -----------------------------------------------------------
REDIS_URL=redis://redis:6379

# ---- JWT secrets (generate strong random strings) -------------------
# openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_STRONG_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_STRONG_SECRET

# ---- App URLs --------------------------------------------------------
FRONTEND_URL=https://yourdomain.com
ADMIN_URL=https://admin.yourdomain.com
GOOGLE_AUTH_REDIRECT_URL=https://yourdomain.com/account
WEBAUTHN_ORIGIN=https://yourdomain.com
WEBAUTHN_RP_ID=yourdomain.com

# ---- Google OAuth ---------------------------------------------------
GOOGLE_CLIENT_ID=77504739590-38mp2ithk78g7vrgbhadf20nj920s9or.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_WITH_REAL_SECRET

# ---- Cloudflare R2 --------------------------------------------------
CLOUDFLARE_R2_ACCOUNT_ID=your_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_access_key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_secret_key
CLOUDFLARE_R2_BUCKET_NAME=your_bucket_name
CLOUDFLARE_R2_PUBLIC_URL=https://your_r2_public_url

# ---- Razorpay (switch to live keys for production) ------------------
RAZORPAY_KEY_ID=rzp_live_REPLACE
RAZORPAY_KEY_SECRET=REPLACE
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_NEW_WEBHOOK_SECRET

# ---- Email (Resend) -------------------------------------------------
RESEND_API_KEY=REPLACE
EMAIL_FROM=noreply@yourdomain.com
